// Daily FVG Retracement, SHORT mirror -- TradingView indicator.
//
// SHARED LOGIC, DUPLICATED BY HAND. The gap-detection block in this file
// (find a gap, kill an invalidated one, trigger an entry, register a new one)
// also exists in:
//     daily_fvg_long_indicator.pine   indicator, long
//     daily_fvg_long_strategy.pine    strategy,  long
//     daily_fvg_short_indicator.pine  indicator, short (mirrored, not copied)
//     daily_fvg_short_strategy.pine   strategy,  short (mirrored, not copied)
// Pine cannot share code between scripts without publishing a library to
// TradingView, and a private repo cannot do that, so the duplication is
// deliberate. A change to the detection logic must be applied to all four by
// hand. The short files mirror rather than copy: their comparisons are
// inverted, so port the intent, not the characters.
//
// ============================== READ THIS FIRST =============================
// NOT A VALIDATED RULE. This indicator marks the bearish setups so they can be
// looked at; it is not evidence that shorting them works. Measured on the
// daily-exit model from 2021-07-15, 0.25x ATR buffer, 2% risk, pivot 12:
//
//   At the shipped settings (D1 bias, 2R):
//              avgR                PF     return   maxDD
//   XAUUSD     +0.017 +/-0.277     0.98    -3.6%   -16.5%
//   XAGUSD     -0.303 +/-0.198     0.62   -32.0%   -34.4%
//   USTEC      -0.136 +/-0.256     0.78   -13.7%   -16.4%
//   EURUSD     -0.417 +/-0.195     0.56   -43.9%   -44.7%
//
// GOLD IS THE EXCEPTION, and only on D1 bias. Sweeping the target there gives
// +0.047R at 1R, +0.111R at 1.5R (PF 1.13, +1.3% over five years), +0.017R at
// 2R and -0.048R at 3R. So gold shorts are marginally positive across most of
// that range rather than losing. On H4 bias gold is negative at every target.
// Silver, USTEC and EURUSD are negative in every configuration tested.
//
// Read the gold result for what it is. The best cell is +1.3% over five years
// with a 15.6% drawdown, on 30 trades, with an error bar (+/-0.232) twice the
// size of the result. That is indistinguishable from zero, and economically it
// is worse than leaving the money alone. It is not a reason to trade shorts;
// it is a reason not to claim they always lose.
//
// This is not a tuning problem. daily_fvg_bearish.py and
// daily_fvg_bearish_ltf_bias.py reached the same verdict independently at
// different parameters. If "any imbalance is a magnet" were symmetrically
// true, shorting bearish gaps should work about as well as buying bullish
// ones. It does not, which is evidence that the gap is not what carries the
// edge on the long side; upward drift in the instrument is, and a short has
// no such tailwind.
// ============================================================================
//
// RULE (the exact mirror of daily_fvg_long_indicator.pine):
//   1. Bearish daily FVG = 3-candle imbalance where high[0] < low[2].
//      top = low of the first candle, bottom = high of the third.
//      The gap is only known once that third candle CLOSES.
//   2. From the day AFTER it forms, the gap waits to be revisited.
//   3. If a daily close rises above the gap's top, the gap is dead.
//   4. Otherwise, the first day whose range touches the gap triggers it.
//   5. Entry = short at the NEXT day's open. Stop = gap top + buffer x ATR14
//      taken at the gap's formation day. Target = entry - 2R.
//   6. Short only, one trade at a time, each gap fires at most once.
//   7. Only sell while HTF structure reads BEARISH.
//
// SIMPLIFICATIONS (flagged):
//   - Runs on the DAILY chart only, so exits resolve on daily bars. A day
//     containing both stop and target is shown as a stop.
//   - The bias filter is gated on the trigger day's close, one bar before
//     daily_fvg_ltf_bias.py reads it.
//   - Position sizing, commission and the equity curve are not modelled.
//
// NON-REPAINTING: every decision uses only closed daily bars. Gap detection
// reads low[2], invalidation and the trigger read a completed daily close,
// and the entry is drawn on the bar AFTER the trigger.

//@version=5
indicator("Daily FVG Short (research)", "FVG Short", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ------------------------------------------------------------------ inputs --
atrLen        = input.int(14,     "ATR length",           minval = 1,   group = "Rule")
atrBufferMult = input.float(0.25, "Stop buffer (x ATR)",  minval = 0.0, step = 0.05, group = "Rule")
targetRR      = input.float(2.0,  "Target (R:R)",         minval = 0.1, step = 0.1,  group = "Rule")

showGaps   = input.bool(true, "Show gap zones",             group = "Display")
showInfo   = input.bool(true, "Show settings panel",        group = "Display")
showDead   = input.bool(false, "Keep invalidated gaps",     group = "Display")
showTrades = input.bool(true, "Show entry / stop / target", group = "Display")

colGap    = input.color(color.new(color.maroon, 85), "Gap zone",    group = "Colours")
colDead   = input.color(color.new(color.gray,   90), "Invalidated", group = "Colours")
colEntry  = input.color(color.purple, "Entry",  group = "Colours")
colStop   = input.color(color.red,    "Stop",   group = "Colours")
colTarget = input.color(color.green,  "Target", group = "Colours")

if not timeframe.isdaily and barstate.islast
    label.new(bar_index, high, "Daily FVG Short: switch the chart to the 1D timeframe.",
         style = label.style_label_down, color = color.orange, textcolor = color.white)

atr = ta.atr(atrLen)

useBias   = input.bool(true, "Only sell when HTF structure is bearish", group = "Bias filter")
biasTf    = input.timeframe("1D", "Bias timeframe",  group = "Bias filter")
pivotSize = input.int(12, "Pivot lookback (size)", minval = 1, group = "Bias filter")
showBias  = input.bool(true, "Tint background when bias is bullish", group = "Bias filter")
biasMissing = input.string("Block trades", "When bias data is unavailable",
     options = ["Block trades", "Allow trades"], group = "Bias filter")

// Identical BOS/CHoCH structure to the long file, ported from smc_structure.py.
// Only the direction required at the entry differs.
structureBias() =>
    hh = ta.highest(high, pivotSize)   // hoisted: ta.* must run every bar
    ll = ta.lowest(low, pivotSize)
    var int   leg       = 0
    var float pivotHigh = na
    var float pivotLow  = na
    var bool  phCrossed = true
    var bool  plCrossed = true
    var int   curBias   = 0
    if bar_index >= pivotSize
        newLegHigh = high[pivotSize] > hh
        newLegLow  = low[pivotSize]  < ll
        prevLeg = leg
        if newLegHigh
            leg := 0
        else if newLegLow
            leg := 1
        if leg != prevLeg
            if leg == 0
                pivotHigh := high[pivotSize]
                phCrossed := false
            else
                pivotLow := low[pivotSize]
                plCrossed := false
    if not na(pivotHigh) and not phCrossed and close > pivotHigh
        phCrossed := true
        curBias   := 1
    else if not na(pivotLow) and not plCrossed and close < pivotLow
        plCrossed := true
        curBias   := -1
    curBias

htfBias   = request.security(syminfo.tickerid, biasTf, structureBias(),
     lookahead = barmerge.lookahead_off)
biasKnown = not na(htfBias)

// Mirror of the long file: shorts require BEARISH structure.
biasOk = not useBias or (biasKnown ? htfBias == -1 : biasMissing == "Allow trades")

// Green where the filter is refusing to sell (structure is bullish); grey
// where the bias cannot be evaluated at all, which is what the early years of
// a long daily history look like when the bias timeframe has no data there.
bgcolor(not (showBias and useBias) ? na :
     not biasKnown  ? color.new(color.gray, 90) :
     htfBias != -1  ? color.new(color.green, 93) : na)

var int firstBiasTime = na
if biasKnown and na(firstBiasTime)
    firstBiasTime := time
if barstate.islast and useBias
    txt = na(firstBiasTime) ?
         "Bias filter: NO " + biasTf + " data on this symbol at all." :
         "Bias filter active from " + str.format_time(firstBiasTime, "yyyy-MM-dd") +
         " (" + biasTf + " history starts there)"
    label.new(bar_index, low, txt, style = label.style_label_up,
         color = color.new(color.blue, 20), textcolor = color.white, size = size.small)

// ------------------------------------------------------- active gap state --
var array<float> gapTop    = array.new_float()
var array<float> gapBottom = array.new_float()
var array<float> gapAtr    = array.new_float()   // ATR at formation, fixes the stop
var array<box>   gapBox    = array.new_box()

// -------------------------------------------------------- open trade state --
var bool  inTrade  = false
var float tEntry   = na
var float tStop    = na
var float tTarget  = na
var line  lnEntry  = na
var line  lnStop   = na
var line  lnTarget = na

var bool  pending     = false
var float pendingStop = na

closeTradeLines() =>
    if not na(lnEntry)
        line.set_x2(lnEntry,  bar_index)
        line.set_x2(lnStop,   bar_index)
        line.set_x2(lnTarget, bar_index)

if timeframe.isdaily and barstate.isconfirmed

    // 1. Resolve an open short. Stop is checked before target, the same
    //    OHLC-only convention simulate_exit() uses in htf_ltf_backtest.py.
    //    For a short the stop is ABOVE the entry and the target below it.
    if inTrade
        if high >= tStop
            closeTradeLines()
            if showTrades
                label.new(bar_index, tStop, "SL", style = label.style_label_down,
                     color = colStop, textcolor = color.white, size = size.tiny)
            inTrade := false
        else if low <= tTarget
            closeTradeLines()
            if showTrades
                label.new(bar_index, tTarget, "TP", style = label.style_label_up,
                     color = colTarget, textcolor = color.white, size = size.tiny)
            inTrade := false
        else if showTrades
            closeTradeLines()

    // 2. Fill a pending short at this bar's open.
    if pending and not inTrade
        risk = pendingStop - open
        if risk > 0
            tEntry  := open
            tStop   := pendingStop
            tTarget := open - targetRR * risk
            inTrade := true
            if showTrades
                lnEntry  := line.new(bar_index, tEntry,  bar_index, tEntry,  color = colEntry,  width = 2)
                lnStop   := line.new(bar_index, tStop,   bar_index, tStop,   color = colStop,   style = line.style_dashed)
                lnTarget := line.new(bar_index, tTarget, bar_index, tTarget, color = colTarget, style = line.style_dashed)
                label.new(bar_index, tEntry, "SELL", style = label.style_label_down,
                     color = colEntry, textcolor = color.white, size = size.tiny)
        pending     := false
        pendingStop := na

    // 3. Walk the waiting gaps, backwards so removal does not shift slots.
    if array.size(gapTop) > 0
        for i = array.size(gapTop) - 1 to 0
            gTop = array.get(gapTop, i)
            gBot = array.get(gapBottom, i)
            bx   = array.get(gapBox, i)

            if close > gTop
                // Dead: price closed back up through the whole imbalance.
                if showDead and not na(bx)
                    box.set_bgcolor(bx, colDead)
                    box.set_border_color(bx, colDead)
                else if not na(bx)
                    box.delete(bx)
                array.remove(gapTop, i)
                array.remove(gapBottom, i)
                array.remove(gapAtr, i)
                array.remove(gapBox, i)

            else if low <= gTop and high >= gBot
                // Touched: this gap is used up, and arms a short for tomorrow.
                if not na(bx)
                    box.set_right(bx, bar_index)
                if not inTrade and not pending and biasOk
                    pending     := true
                    pendingStop := gTop + atrBufferMult * array.get(gapAtr, i)
                array.remove(gapTop, i)
                array.remove(gapBottom, i)
                array.remove(gapAtr, i)
                array.remove(gapBox, i)

            else if not na(bx)
                box.set_right(bx, bar_index)

    // 4. Register a gap that formed on THIS bar. Done last, so a gap cannot
    //    be triggered by the very candle that created it.
    if high < low[2]
        box newBox = na
        if showGaps
            newBox := box.new(bar_index - 2, low[2], bar_index, high,
                 bgcolor = colGap, border_color = colGap)
        array.push(gapTop, low[2])
        array.push(gapBottom, high)
        array.push(gapAtr, na(atr) ? 0.0 : atr)
        array.push(gapBox, newBox)

// ------------------------------------------------------------------ alerts --
// Fires on the close of the day a bearish gap is touched, the evening before
// the short would be taken at the next day's open.
armedToday = pending and barstate.isconfirmed
alertcondition(armedToday, "Daily FVG short armed",
     "Bearish daily FVG touched on {{ticker}}. RESEARCH ONLY: this rule is not validated; see the script header.")

// -------------------------------------------------------------- info panel --
biasTxt = not useBias ? "off" : not biasKnown ? "no data" : htfBias == -1 ? "BEARISH" : "BULLISH"
biasCol = (not useBias or not biasKnown) ? color.gray : htfBias == -1 ? color.red : color.green

hdr(t, r, s) => table.cell(t, 0, r, s, text_color = color.white, text_size = size.small,
     text_halign = text.align_left)
val(t, r, s, c) => table.cell(t, 1, r, s, text_color = c, text_size = size.small,
     text_halign = text.align_right)
note(t, r, s, c) => table.cell(t, 0, r, s, text_color = c, text_size = size.tiny,
     text_halign = text.align_left)

var table info = table.new(position.top_right, 2, 10, border_width = 1,
     frame_width = 1, frame_color = color.new(color.gray, 50),
     bgcolor = color.new(color.black, 20))
if showInfo and barstate.islast
    hdr(info, 0, "Daily FVG SHORT (research)")
    val(info, 0, "", color.white)
    hdr(info, 1, "Bias now")
    val(info, 1, biasTxt, biasCol)
    hdr(info, 2, "Stop buffer")
    val(info, 2, str.tostring(atrBufferMult) + "x ATR", color.white)
    hdr(info, 3, "Target")
    val(info, 3, str.tostring(targetRR) + "R", color.white)
    hdr(info, 4, "Bias source")
    val(info, 4, biasTf + " size " + str.tostring(pivotSize), color.white)
    note(info, 5, "NOT VALIDATED. Shipped settings, avgR:", color.red)
    note(info, 6, "XAUUSD +0.02  XAGUSD -0.30  USTEC -0.14", color.red)
    note(info, 7, "Gold is marginally positive on D1 bias only,", color.silver)
    note(info, 8, "best +1.3% over 5yr on 30 trades: noise.", color.silver)
    note(info, 9, "Shown for inspection. See the file header.", color.silver)
