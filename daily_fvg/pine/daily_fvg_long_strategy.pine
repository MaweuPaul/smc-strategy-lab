// Daily FVG Retracement -- TradingView strategy, v2 (with bias filter).
//
// SHARED LOGIC, DUPLICATED BY HAND. The gap-detection block in this file
// (find a gap, kill an invalidated one, trigger an entry, register a new one)
// also exists in:
//     daily_fvg_long_indicator.pine   indicator, long
//     daily_fvg_long_strategy.pine    strategy,  long
//     daily_fvg_short_indicator.pine  indicator, short (mirrored, not copied)
//     daily_fvg_short_strategy.pine   strategy,  short (mirrored, not copied)
// Pine cannot share code between scripts without publishing a library to
// TradingView, and a private repo cannot do that, so the duplication is
// deliberate. A change to the detection logic must be applied to all four by
// hand. The short files mirror rather than copy: their comparisons are
// inverted, so port the intent, not the characters.
//
// The strategy() twin of daily_fvg_long_indicator.pine. Same rule, same detection code; this
// one places simulated orders so TradingView's Strategy Tester produces its
// own P&L. The point is a THIRD opinion: daily_fvg_newday.py said one thing,
// an independent backtesting.py port agreed on every entry signal, and this
// lets TradingView's engine be asked the same question.
//
// This places orders in TradingView's simulator only. Nothing in this repo
// connects to a broker, and this file does not change that.
//
// RULE (identical to daily_fvg_newday.py and to daily_fvg_long_indicator.pine):
//   1. Bullish daily FVG = 3-candle imbalance where low[0] > high[2].
//   2. Eligible from the day AFTER it forms.
//   3. A daily close below the gap's bottom kills it.
//   4. The first day whose range touches the gap triggers it.
//   5. Entry = next day's open. Stop = gap bottom - 0.25x ATR14 at formation.
//      Target = entry + 2R.
//   6. Long only, one position at a time, each gap fires at most once.
//
// MONEY SETTINGS mirror daily_fvg_newday.py: 100,000 start, 1.5% risked per
// trade, position capped at 5x equity in notional, 0.05% commission a side.
//
// SIMPLIFICATIONS (flagged):
//   - Daily chart only, so exits resolve on daily bars. The Python engine
//     resolves them on M15, which is finer. Expect the trade COUNT and P&L to
//     differ from the Python run for this reason alone; the entry signals are
//     what should agree.
//   - Exit orders are submitted on the bar the entry fills, so they go live
//     from the following bar. A day that would have hit stop or target on the
//     entry day itself is therefore handled a day late here. Check the
//     Strategy Tester's trade list against the expected numbers in
//     ../README.md before trusting the totals.
//   - Position size is computed from the TRIGGER day's close, because the
//     real fill price (the next day's open) is not knowable when the order is
//     submitted. The Python engine sizes off the actual fill.
//   - The bias filter is gated when the ORDER IS SUBMITTED (the trigger day's
//     close). daily_fvg_ltf_bias.py instead reads bias at the entry time, one
//     bar later. The H4 bias rarely flips overnight, but they are not
//     identical tests.
//
// DEFAULTS ARE AIMED AT METALS. Gold and silver are the only instruments
// where this rule held up across every variation tested (see ../README.md).
// The shipped values trade relatively often and accept a deeper drawdown for
// it. Measured filtered, D1 bias, 2% risk, from 2021-07-15:
//
//     0.25x buffer / 2R  (shipped)   XAUUSD +0.558R PF 2.14 DD -19.5%
//                                    XAGUSD +0.227R PF 1.37 DD -17.3%
//     1.0x  buffer / 3R             XAUUSD +0.721R PF 2.23 DD  -6.3%
//                                    XAGUSD +0.716R PF 2.34 DD  -7.7%
//
// The wider-stop configuration measured better on both metals with roughly a
// third of the drawdown, at the cost of a third of the trades. It is worth
// trying before assuming the shipped values are the right ones for you.
//
// The bias timeframe is D1 rather than H4 because D1 is the only source that
// was positive on BOTH metals at these settings (H4 is the best single result
// on gold but the worst on silver), and because daily history reaches back
// decades further than intraday, so the filter can actually be evaluated on
// the long out-of-sample window. These differences are inside the noise at
// 30-50 trades; D1 is chosen for robustness and data availability, not
// because it measurably wins.
//
// NON-REPAINTING: every decision uses only closed daily bars, and orders are
// submitted on bar close and filled at the next bar's open.

//@version=5
strategy("Daily FVG Long (strategy)", "FVG Long ST", overlay = true,
     initial_capital       = 100000,
     currency              = currency.USD,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     pyramiding            = 0,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.05,
     calc_on_every_tick    = false,
     process_orders_on_close = false,
     max_boxes_count       = 500)

// ------------------------------------------------------------------ inputs --
atrLen        = input.int(14,     "ATR length",          minval = 1,   group = "Rule")
atrBufferMult = input.float(0.25, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = "Rule")
targetRR      = input.float(2.0,  "Target (R:R)",        minval = 0.1, step = 0.1,  group = "Rule")

sizingMode = input.string("Risk %", "Position sizing", options = ["Risk %", "Fixed units"], group = "Money")
riskPct    = input.float(2.0, "Risk per trade (%)",  minval = 0.01, step = 0.1, group = "Money")
maxLev     = input.float(5.0, "Max notional (x equity)", minval = 0.1, step = 0.5, group = "Money")
fixedUnits = input.float(10.0, "Fixed units",        minval = 0.0001, step = 1, group = "Money")

showGaps = input.bool(true, "Show gap zones", group = "Display")
showInfo = input.bool(true, "Show settings panel", group = "Display")
colGap   = input.color(color.new(color.teal, 85), "Gap zone", group = "Display")

// Backtest windowing. The default start is 2000, not 2018: TradingView's daily
// history on many symbols runs decades further back than the MT5 cache the
// Python engine reads, so this is genuinely out-of-sample data the repo's own
// results have never touched. It is a floor rather than a hard rule; lower it
// if the symbol has good data earlier. Do not simply disable the range on a
// symbol whose history reaches the 1800s, where prices are a few cents and
// risk-based sizing buys absurd quantities.
useRange  = input.bool(true, "Limit to a date range", group = "Backtest window")
startDate = input.time(timestamp("1 Jan 2018"), "From", group = "Backtest window")
endDate   = input.time(timestamp("7 Oct 2026"), "To",   group = "Backtest window")
inWindow  = not useRange or (time >= startDate and time <= endDate)

if not timeframe.isdaily and barstate.islast
    label.new(bar_index, high, "Daily FVG: switch the chart to the 1D timeframe.",
         style = label.style_label_down, color = color.orange, textcolor = color.white)

atr = ta.atr(atrLen)

useBias   = input.bool(true, "Only buy when HTF structure is bullish", group = "Bias filter")
biasTf    = input.timeframe("1D", "Bias timeframe",  group = "Bias filter")
pivotSize = input.int(12, "Pivot lookback (size)", minval = 1, group = "Bias filter")
showBias  = input.bool(true, "Tint background when bias is bearish", group = "Bias filter")
biasMissing = input.string("Block trades", "When bias data is unavailable",
     options = ["Block trades", "Allow trades"], group = "Bias filter")

// BOS / CHoCH structure bias, ported from smc_structure.py, which is itself a
// port of the LuxAlgo "Smart Money Concepts" swing logic. Bias flips the
// moment a close crosses the last still-unbroken pivot, rather than waiting
// for two swings to agree. A pivot at bar j is only detected at j+size, so it
// is non-repainting by construction.
//
// This is the filter daily_fvg_ltf_bias.py found to work: it improves win
// rate, avg R, profit factor AND drawdown, at the cost of roughly a third of
// the trades. See ../README.md for measured numbers.
structureBias() =>
    hh = ta.highest(high, pivotSize)   // hoisted: ta.* must run every bar
    ll = ta.lowest(low, pivotSize)
    var int   leg       = 0
    var float pivotHigh = na
    var float pivotLow  = na
    var bool  phCrossed = true
    var bool  plCrossed = true
    var int   curBias   = 0
    if bar_index >= pivotSize
        newLegHigh = high[pivotSize] > hh
        newLegLow  = low[pivotSize]  < ll
        prevLeg = leg
        if newLegHigh
            leg := 0                       // bearish leg starts -> pivot HIGH
        else if newLegLow
            leg := 1                       // bullish leg starts -> pivot LOW
        if leg != prevLeg
            if leg == 0
                pivotHigh := high[pivotSize]
                phCrossed := false
            else
                pivotLow := low[pivotSize]
                plCrossed := false
    if not na(pivotHigh) and not phCrossed and close > pivotHigh
        phCrossed := true
        curBias   := 1
    else if not na(pivotLow) and not plCrossed and close < pivotLow
        plCrossed := true
        curBias   := -1
    curBias

htfBias   = request.security(syminfo.tickerid, biasTf, structureBias(),
     lookahead = barmerge.lookahead_off)
biasKnown = not na(htfBias)

// Intraday history is far shorter than daily history. Running the daily chart
// back to the 1990s means the bias timeframe simply does not exist for the
// early years, and request.security returns na there. Comparing na to 1 is
// false, so the filter would silently refuse EVERY trade in that era and the
// run would look like the rule found nothing, rather than like the filter
// could not be evaluated. That case is made explicit and configurable.
biasOk = not useBias or (biasKnown ? htfBias == 1 : biasMissing == "Allow trades")

// Red where the filter is refusing to buy; grey where it cannot be evaluated
// at all. A missing signal should always be visibly a decision, not a bug.
bgcolor(not (showBias and useBias) ? na :
     not biasKnown  ? color.new(color.gray, 90) :
     htfBias != 1   ? color.new(color.red, 93)  : na)

// Report where the bias timeframe actually begins, so the usable window is a
// stated fact rather than something inferred from a thin-looking trade list.
var int firstBiasTime = na
if biasKnown and na(firstBiasTime)
    firstBiasTime := time
if barstate.islast and useBias
    txt = na(firstBiasTime) ?
         "Bias filter: NO " + biasTf + " data on this symbol at all." :
         "Bias filter active from " + str.format_time(firstBiasTime, "yyyy-MM-dd") +
         " (" + biasTf + " history starts there)"
    label.new(bar_index, low, txt, style = label.style_label_up,
         color = color.new(color.blue, 20), textcolor = color.white, size = size.small)

// ------------------------------------------------------- active gap state --
var array<float> gapTop    = array.new_float()
var array<float> gapBottom = array.new_float()
var array<float> gapAtr    = array.new_float()
var array<box>   gapBox    = array.new_box()

// The stop travels with the order: submitted on the trigger day, attached to
// the position once it fills on the next day's open.
var float pendingStop = na
var float activeStop  = na

if timeframe.isdaily and barstate.isconfirmed

    // 1. Promote the stop submitted yesterday. The order has filled at THIS
    //    bar's open, so this must happen before the exit is attached, or the
    //    position spends its first bar with no protective order at all.
    if not na(pendingStop)
        activeStop  := pendingStop
        pendingStop := na

    // 2. Attach or refresh the protective orders off the real fill price.
    if strategy.position_size > 0 and not na(activeStop)
        risk = strategy.position_avg_price - activeStop
        if risk > 0
            strategy.exit("exit", from_entry = "FVG",
                 stop  = activeStop,
                 limit = strategy.position_avg_price + targetRR * risk)
        else
            // The fill gapped to or through the stop, so there is no valid
            // trade: daily_fvg_newday.py drops these outright (r <= 0). Pine
            // has already entered by the time the fill price is known, so the
            // nearest equivalent is to close immediately. Leaving it open was
            // the bug that produced a single never-closing position.
            strategy.close("FVG", comment = "no risk")
            activeStop := na

    // 2b. Safety net. A position with no stop attached can never be closed by
    //     this script, and because entries require being flat, it also blocks
    //     every later trade. If that state is ever reached, close out.
    if strategy.position_size > 0 and na(activeStop) and na(pendingStop)
        strategy.close("FVG", comment = "unprotected")

    // 3. Walk the waiting gaps, backwards so removal does not shift slots.
    if array.size(gapTop) > 0
        for i = array.size(gapTop) - 1 to 0
            gTop = array.get(gapTop, i)
            gBot = array.get(gapBottom, i)
            bx   = array.get(gapBox, i)

            if close < gBot
                if not na(bx)
                    box.delete(bx)
                array.remove(gapTop, i)
                array.remove(gapBottom, i)
                array.remove(gapAtr, i)
                array.remove(gapBox, i)

            else if low <= gTop and high >= gBot
                if not na(bx)
                    box.set_right(bx, bar_index)
                flat = strategy.position_size == 0 and na(pendingStop)
                if flat and inWindow and biasOk
                    stopPx = gBot - atrBufferMult * array.get(gapAtr, i)
                    // Size off today's close: the actual fill is tomorrow's
                    // open and cannot be known here.
                    est  = close
                    risk = est - stopPx
                    if risk > 0
                        qty = fixedUnits
                        if sizingMode == "Risk %"
                            byRisk = strategy.equity * (riskPct / 100.0) / risk
                            byLev  = strategy.equity * maxLev / est
                            qty := math.min(byRisk, byLev)
                        if qty > 0
                            strategy.entry("FVG", strategy.long, qty = qty)
                            pendingStop := stopPx
                array.remove(gapTop, i)
                array.remove(gapBottom, i)
                array.remove(gapAtr, i)
                array.remove(gapBox, i)

            else if not na(bx)
                box.set_right(bx, bar_index)

    // 4. Register a gap formed on THIS bar, last, so it cannot fire today.
    if low > high[2]
        box newBox = na
        if showGaps
            newBox := box.new(bar_index - 2, low, bar_index, high[2],
                 bgcolor = colGap, border_color = colGap)
        array.push(gapTop, low)
        array.push(gapBottom, high[2])
        array.push(gapAtr, na(atr) ? 0.0 : atr)
        array.push(gapBox, newBox)

// Once flat again, forget the stop so the next trade starts clean.
if strategy.position_size == 0 and na(pendingStop)
    activeStop := na

// -------------------------------------------------------------- info panel --
// The shipped values are a starting point, not a recommendation. Every input
// here is a tolerance dial: the same rule can be made to trade often with deep
// drawdowns, or rarely with shallow ones, and neither is objectively correct.
// What matters is landing on a drawdown that can actually be sat through
// without abandoning the rule halfway, because a rule abandoned mid-drawdown
// captures the losses and none of the recovery.
biasTxt = not useBias ? "off" : not biasKnown ? "no data" : htfBias == 1 ? "BULLISH" : "BEARISH"
biasCol = (not useBias or not biasKnown) ? color.gray : htfBias == 1 ? color.green : color.red

hdr(t, r, s) => table.cell(t, 0, r, s, text_color = color.white, text_size = size.small,
     text_halign = text.align_left)
val(t, r, s, c) => table.cell(t, 1, r, s, text_color = c, text_size = size.small,
     text_halign = text.align_right)
note(t, r, s) => table.cell(t, 0, r, s, text_color = color.silver, text_size = size.tiny,
     text_halign = text.align_left)

var table info = table.new(position.top_right, 2, 12, border_width = 1,
     frame_width = 1, frame_color = color.new(color.gray, 50),
     bgcolor = color.new(color.black, 20))
if showInfo and barstate.islast
    hdr(info, 0, "Daily FVG (metals-tuned)")
    val(info, 0, "", color.white)
    hdr(info, 1, "Bias now")
    val(info, 1, biasTxt, biasCol)
    hdr(info, 2, "Stop buffer")
    val(info, 2, str.tostring(atrBufferMult) + "x ATR", color.white)
    hdr(info, 3, "Target")
    val(info, 3, str.tostring(targetRR) + "R", color.white)
    hdr(info, 4, "Risk / trade")
    val(info, 4, str.tostring(riskPct) + "%", color.white)
    hdr(info, 5, "Bias source")
    val(info, 5, biasTf + " size " + str.tostring(pivotSize), color.white)
    hdr(info, 6, "Held up on")
    val(info, 6, "XAUUSD, XAGUSD", color.white)
    note(info, 7, "These settings are a starting point, not advice.")
    note(info, 8, "Wider buffer  = fewer, calmer trades")
    note(info, 9, "Higher risk % = bigger swings both ways")
    note(info, 10, "Tighter bias  = fewer trades, less drawdown")
    note(info, 11, "Tune until the drawdown is one you could sit through.")
