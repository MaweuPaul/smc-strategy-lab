// Daily FVG Retracement, SHORT mirror -- TradingView strategy.
//
// SHARED LOGIC, DUPLICATED BY HAND. The gap-detection block in this file
// (find a gap, kill an invalidated one, trigger an entry, register a new one)
// also exists in:
//     daily_fvg_long_indicator.pine   indicator, long
//     daily_fvg_long_strategy.pine    strategy,  long
//     daily_fvg_short_indicator.pine  indicator, short (mirrored, not copied)
//     daily_fvg_short_strategy.pine   strategy,  short (mirrored, not copied)
// Pine cannot share code between scripts without publishing a library to
// TradingView, and a private repo cannot do that, so the duplication is
// deliberate. A change to the detection logic must be applied to all four by
// hand. The short files mirror rather than copy: their comparisons are
// inverted, so port the intent, not the characters.
//
// ============================== READ THIS FIRST =============================
// NOT A VALIDATED RULE. It exists so the bearish case can be measured and
// looked at, not because shorting these setups was found to work. Measured on
// the daily-exit model from 2021-07-15, 0.25x ATR buffer, 2% risk, pivot 12:
//
//   At the shipped settings (D1 bias, 2R):
//              avgR                PF     return   maxDD
//   XAUUSD     +0.017 +/-0.277     0.98    -3.6%   -16.5%
//   XAGUSD     -0.303 +/-0.198     0.62   -32.0%   -34.4%
//   USTEC      -0.136 +/-0.256     0.78   -13.7%   -16.4%
//   EURUSD     -0.417 +/-0.195     0.56   -43.9%   -44.7%
//
// GOLD IS THE EXCEPTION, and only on D1 bias. Sweeping the target there gives
// +0.047R at 1R, +0.111R at 1.5R (PF 1.13, +1.3% over five years), +0.017R at
// 2R and -0.048R at 3R, so gold shorts are marginally positive across most of
// that range. On H4 bias gold is negative at every target. Silver, USTEC and
// EURUSD are negative in every configuration tested.
//
// Read the gold result for what it is: +1.3% over five years with a 15.6%
// drawdown, on 30 trades, with an error bar (+/-0.232) twice the size of the
// result. Indistinguishable from zero, and economically worse than leaving the
// money alone. Not a reason to trade shorts, but a reason not to claim they
// always lose.
//
// For contrast, the long file at its own shipped settings: XAUUSD +0.558R
// PF 2.14, XAGUSD +0.227R PF 1.37.
//
// daily_fvg_bearish.py and daily_fvg_bearish_ltf_bias.py reached a similar
// verdict independently at different parameters, and ../README.md records the
// reasoning: if "any imbalance is a magnet" were symmetrically true, shorting
// bearish gaps should work about as well as buying bullish ones. It does not,
// which is evidence that the gap is not what carries the edge on the long
// side; upward drift in the instrument is, and a short has no such tailwind.
//
// ============================================================================
//
// RULE (the exact mirror of daily_fvg_long_strategy.pine):
//   1. Bearish daily FVG = 3-candle imbalance where high[0] < low[2].
//      top = low of the first candle, bottom = high of the third.
//   2. Eligible from the day AFTER it forms.
//   3. A daily close ABOVE the gap's top kills it.
//   4. The first day whose range touches the gap triggers it.
//   5. Entry = short at the next day's open. Stop = gap top + buffer x ATR14
//      at formation. Target = entry - 2R.
//   6. Short only, one position at a time, each gap fires at most once.
//   7. Only sell while HTF structure reads BEARISH.
//
// SIMPLIFICATIONS (same as the long file):
//   - Daily chart only, so exits resolve on daily bars.
//   - Exit orders go live the bar after the fill.
//   - Size is computed from the trigger day's close, since the real fill is
//     the next day's open and is not knowable when the order is submitted.
//
// NON-REPAINTING: every decision uses only closed daily bars, and orders are
// submitted on bar close and filled at the next bar's open.

//@version=5
strategy("Daily FVG Short (research, strategy)", "FVG Short ST", overlay = true,
     initial_capital       = 100000,
     currency              = currency.USD,
     default_qty_type      = strategy.fixed,
     default_qty_value     = 1,
     pyramiding            = 0,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.05,
     calc_on_every_tick    = false,
     process_orders_on_close = false,
     max_boxes_count       = 500)

// ------------------------------------------------------------------ inputs --
atrLen        = input.int(14,     "ATR length",          minval = 1,   group = "Rule")
atrBufferMult = input.float(0.25, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = "Rule")
targetRR      = input.float(2.0,  "Target (R:R)",        minval = 0.1, step = 0.1,  group = "Rule")

sizingMode = input.string("Risk %", "Position sizing", options = ["Risk %", "Fixed units"], group = "Money")
riskPct    = input.float(2.0, "Risk per trade (%)",  minval = 0.01, step = 0.1, group = "Money")
maxLev     = input.float(5.0, "Max notional (x equity)", minval = 0.1, step = 0.5, group = "Money")
fixedUnits = input.float(10.0, "Fixed units",        minval = 0.0001, step = 1, group = "Money")

showGaps = input.bool(true, "Show gap zones", group = "Display")
showInfo = input.bool(true, "Show settings panel", group = "Display")
colGap   = input.color(color.new(color.maroon, 85), "Gap zone", group = "Display")

useRange  = input.bool(true, "Limit to a date range", group = "Backtest window")
startDate = input.time(timestamp("1 Jan 2018"), "From", group = "Backtest window")
endDate   = input.time(timestamp("7 Oct 2026"), "To",   group = "Backtest window")
inWindow  = not useRange or (time >= startDate and time <= endDate)

if not timeframe.isdaily and barstate.islast
    label.new(bar_index, high, "Daily FVG Short: switch the chart to the 1D timeframe.",
         style = label.style_label_down, color = color.orange, textcolor = color.white)

atr = ta.atr(atrLen)

useBias   = input.bool(true, "Only sell when HTF structure is bearish", group = "Bias filter")
biasTf    = input.timeframe("1D", "Bias timeframe",  group = "Bias filter")
pivotSize = input.int(12, "Pivot lookback (size)", minval = 1, group = "Bias filter")
showBias  = input.bool(true, "Tint background when bias is bullish", group = "Bias filter")
biasMissing = input.string("Block trades", "When bias data is unavailable",
     options = ["Block trades", "Allow trades"], group = "Bias filter")

// Identical BOS/CHoCH structure to the long file, ported from smc_structure.py.
// Only the direction required at the entry differs.
structureBias() =>
    hh = ta.highest(high, pivotSize)   // hoisted: ta.* must run every bar
    ll = ta.lowest(low, pivotSize)
    var int   leg       = 0
    var float pivotHigh = na
    var float pivotLow  = na
    var bool  phCrossed = true
    var bool  plCrossed = true
    var int   curBias   = 0
    if bar_index >= pivotSize
        newLegHigh = high[pivotSize] > hh
        newLegLow  = low[pivotSize]  < ll
        prevLeg = leg
        if newLegHigh
            leg := 0
        else if newLegLow
            leg := 1
        if leg != prevLeg
            if leg == 0
                pivotHigh := high[pivotSize]
                phCrossed := false
            else
                pivotLow := low[pivotSize]
                plCrossed := false
    if not na(pivotHigh) and not phCrossed and close > pivotHigh
        phCrossed := true
        curBias   := 1
    else if not na(pivotLow) and not plCrossed and close < pivotLow
        plCrossed := true
        curBias   := -1
    curBias

htfBias   = request.security(syminfo.tickerid, biasTf, structureBias(),
     lookahead = barmerge.lookahead_off)
biasKnown = not na(htfBias)

// Mirror of the long file: shorts require BEARISH structure.
biasOk = not useBias or (biasKnown ? htfBias == -1 : biasMissing == "Allow trades")

// Green where the filter is refusing to sell (structure is bullish); grey
// where the bias cannot be evaluated at all.
bgcolor(not (showBias and useBias) ? na :
     not biasKnown   ? color.new(color.gray, 90) :
     htfBias != -1   ? color.new(color.green, 93) : na)

var int firstBiasTime = na
if biasKnown and na(firstBiasTime)
    firstBiasTime := time
if barstate.islast and useBias
    txt = na(firstBiasTime) ?
         "Bias filter: NO " + biasTf + " data on this symbol at all." :
         "Bias filter active from " + str.format_time(firstBiasTime, "yyyy-MM-dd") +
         " (" + biasTf + " history starts there)"
    label.new(bar_index, low, txt, style = label.style_label_up,
         color = color.new(color.blue, 20), textcolor = color.white, size = size.small)

// ------------------------------------------------------- active gap state --
var array<float> gapTop    = array.new_float()
var array<float> gapBottom = array.new_float()
var array<float> gapAtr    = array.new_float()
var array<box>   gapBox    = array.new_box()

var float pendingStop = na
var float activeStop  = na

if timeframe.isdaily and barstate.isconfirmed

    // 1. Promote yesterday's stop: the short filled at this bar's open.
    if not na(pendingStop)
        activeStop  := pendingStop
        pendingStop := na

    // 2. Attach protective orders off the real fill. For a short the stop sits
    //    ABOVE the entry and the target below it.
    if strategy.position_size < 0 and not na(activeStop)
        risk = activeStop - strategy.position_avg_price
        if risk > 0
            strategy.exit("exit", from_entry = "FVGs",
                 stop  = activeStop,
                 limit = strategy.position_avg_price - targetRR * risk)
        else
            // Filled at or above its own stop: no valid trade, close at once.
            strategy.close("FVGs", comment = "no risk")
            activeStop := na

    // 2b. Safety net: an unprotected position can never be closed by this
    //     script and would block every later trade.
    if strategy.position_size < 0 and na(activeStop) and na(pendingStop)
        strategy.close("FVGs", comment = "unprotected")

    // 3. Walk the waiting gaps, backwards so removal does not shift slots.
    if array.size(gapTop) > 0
        for i = array.size(gapTop) - 1 to 0
            gTop = array.get(gapTop, i)
            gBot = array.get(gapBottom, i)
            bx   = array.get(gapBox, i)

            if close > gTop
                // Dead: price closed back up through the whole imbalance.
                if not na(bx)
                    box.delete(bx)
                array.remove(gapTop, i)
                array.remove(gapBottom, i)
                array.remove(gapAtr, i)
                array.remove(gapBox, i)

            else if low <= gTop and high >= gBot
                if not na(bx)
                    box.set_right(bx, bar_index)
                flat = strategy.position_size == 0 and na(pendingStop)
                if flat and inWindow and biasOk
                    stopPx = gTop + atrBufferMult * array.get(gapAtr, i)
                    est  = close
                    risk = stopPx - est
                    if risk > 0
                        qty = fixedUnits
                        if sizingMode == "Risk %"
                            byRisk = strategy.equity * (riskPct / 100.0) / risk
                            byLev  = strategy.equity * maxLev / est
                            qty := math.min(byRisk, byLev)
                        if qty > 0
                            strategy.entry("FVGs", strategy.short, qty = qty)
                            pendingStop := stopPx
                array.remove(gapTop, i)
                array.remove(gapBottom, i)
                array.remove(gapAtr, i)
                array.remove(gapBox, i)

            else if not na(bx)
                box.set_right(bx, bar_index)

    // 4. Register a gap formed on THIS bar, last, so it cannot fire today.
    if high < low[2]
        box newBox = na
        if showGaps
            newBox := box.new(bar_index - 2, low[2], bar_index, high,
                 bgcolor = colGap, border_color = colGap)
        array.push(gapTop, low[2])
        array.push(gapBottom, high)
        array.push(gapAtr, na(atr) ? 0.0 : atr)
        array.push(gapBox, newBox)

if strategy.position_size == 0 and na(pendingStop)
    activeStop := na

// -------------------------------------------------------------- info panel --
biasTxt = not useBias ? "off" : not biasKnown ? "no data" : htfBias == -1 ? "BEARISH" : "BULLISH"
biasCol = (not useBias or not biasKnown) ? color.gray : htfBias == -1 ? color.red : color.green

hdr(t, r, s) => table.cell(t, 0, r, s, text_color = color.white, text_size = size.small,
     text_halign = text.align_left)
val(t, r, s, c) => table.cell(t, 1, r, s, text_color = c, text_size = size.small,
     text_halign = text.align_right)
note(t, r, s, c) => table.cell(t, 0, r, s, text_color = c, text_size = size.tiny,
     text_halign = text.align_left)

var table info = table.new(position.top_right, 2, 11, border_width = 1,
     frame_width = 1, frame_color = color.new(color.gray, 50),
     bgcolor = color.new(color.black, 20))
if showInfo and barstate.islast
    hdr(info, 0, "Daily FVG SHORT (research)")
    val(info, 0, "", color.white)
    hdr(info, 1, "Bias now")
    val(info, 1, biasTxt, biasCol)
    hdr(info, 2, "Stop buffer")
    val(info, 2, str.tostring(atrBufferMult) + "x ATR", color.white)
    hdr(info, 3, "Target")
    val(info, 3, str.tostring(targetRR) + "R", color.white)
    hdr(info, 4, "Risk / trade")
    val(info, 4, str.tostring(riskPct) + "%", color.white)
    hdr(info, 5, "Bias source")
    val(info, 5, biasTf + " size " + str.tostring(pivotSize), color.white)
    note(info, 6, "NOT VALIDATED. Shipped settings, avgR:", color.red)
    note(info, 7, "XAUUSD +0.02  XAGUSD -0.30  USTEC -0.14", color.red)
    note(info, 8, "Gold is marginally positive on D1 bias only,", color.silver)
    note(info, 9, "best +1.3% over 5yr on 30 trades: noise.", color.silver)
    note(info, 10, "See the file header before trading any of it.", color.silver)
