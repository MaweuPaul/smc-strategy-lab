# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real credentials.
#
# These are cTrader Open API credentials, used only by ctrader_auth.py,
# ctrader_data.py, ctrader_list_accounts.py and ctrader_list_symbols.py --
# an alternative/supplementary data source to the primary MetaTrader 5
# integration the rest of this app uses. You do NOT need these to run the
# main dashboard (Daily FVG, Asian Session, Daily OB, ORB) -- MT5 needs no
# API key, just a running, logged-in terminal.
#
# To get CTRADER_CLIENT_ID / CTRADER_CLIENT_SECRET:
#   1. Apply for API access at https://openapi.ctrader.com/apps
#   2. Approval is manual and typically takes 2-3 business days -- apply
#      before you need it, not the day you plan to use it.
#   3. Once approved, create an application in that dashboard to get your
#      client ID/secret, and register CTRADER_REDIRECT_URI there too (it
#      must match exactly what you put below).
#   4. Run `python ctrader_auth.py` once to complete the OAuth flow in a
#      browser and generate ctrader_session.json (also gitignored).

CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:8090/callback
CTRADER_ACCOUNT_ID=
CTRADER_IS_LIVE=false
