# Secrets -- never commit real credentials or tokens
.env
ctrader_session.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Frontend build artifacts / dependencies
frontend/node_modules/
frontend/dist/

# Generated backtest output (trade logs, equity plots) -- these are
# regenerated by running the scripts, not source. Anchored to the repo
# root so real frontend assets (e.g. frontend/src/assets/*.png) are
# unaffected.
/*.csv
/*.png
scratch/

# Pre-fix backup snapshots kept locally during development, not canonical
# source (git history is the real record of what changed)
audit_backups/

# OS / editor junk
.DS_Store
Thumbs.db
*.log
